# Plantilla de configuración. Cópiala como ".env" y llena los valores de TU equipo.
# El .env real no se comparte ni se sube (contiene la contraseña).

# --- CONEXIÓN A SQL SERVER ---

# Servidor de SQL Server, con el puerto separado por coma.
#   SQL Server en otra máquina o VM:  192.168.x.x,1433
#   SQL Server en tu propio equipo:   localhost   o   localhost\SQLEXPRESS
DB_SERVER=192.168.197.xxx,1433

# Base de datos del proyecto (igual para todo el equipo).
DB_NAME=DatosAbiertosDB

# Controlador ODBC instalado en Windows. Debe coincidir exactamente con el nombre instalado.
DB_DRIVER=ODBC Driver 18 for SQL Server

# Tipo de autenticación:
#   yes = Autenticación de Windows (entra con tu usuario de Windows; no usa DB_USER ni DB_PASSWORD).
#   no  = Login de SQL Server (usa DB_USER y DB_PASSWORD). Es el caso si SQL Server está en una VM u otro equipo.
DB_TRUSTED=no

# Login de SQL Server (solo si DB_TRUSTED=no).
DB_USER=

# Contraseña de ese login (solo si DB_TRUSTED=no). Nunca la escribas en esta plantilla.
DB_PASSWORD=

# --- API DE DATOS ABIERTOS ---

# Identificador del dataset en datos.gov.co (Tráfico de voz de proveedores móviles, MinTIC).
API_RESOURCE_ID=s5df-6cb7

# Cantidad máxima de registros que se piden a la API en cada sincronización.
#   none = todos los registros del dataset (2085). Un número (por ejemplo 100) limita la descarga.
API_LIMIT=none
